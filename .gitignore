internal/ug/testdata/*.txt

# Pipeline output — cleaned tabs and generated .cpro files for the
# ggt-chart-pipeline skill. Copyrighted material; never committed.
/output/

# Standalone helper scripts (scripts/) - Python bytecode cache
__pycache__/
*.pyc
