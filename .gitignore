# Go build output
/bin/
*.exe
*.out

# OS noise
.DS_Store

# Local copyrighted lyrics / tabs — keep real song charts here
# but never commit them to the repo
/ignored/

# Real UG pro_meta API responses and cleaned outputs used as test
